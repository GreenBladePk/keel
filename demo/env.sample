# Copy to env.local (git-ignored) and fill the real RouterPlus key.
#   cp demo/env.sample demo/env.local  &&  $EDITOR demo/env.local  &&  source demo/env.local

# --- Keel server (demo DB + real LLM via RouterPlus, OpenAI-compatible) ---
export DATABASE_URL=postgresql://keel:keel@localhost:5433/keel_demo
export KEEL_LLM_PROVIDER=openai
export OPENAI_API_KEY=__PUT_ROUTERPLUS_KEY_HERE__
export OPENAI_API_BASE=https://api.routerplus.com/v1
export KEEL_LLM_MODEL=openai/gpt-4.1-mini
export KEEL_CORS_ORIGINS=http://localhost:8050

# --- Shared by the two demo terminals (hooks + MCP connector read these) ---
export KEEL_URL=http://localhost:8000/mcp
export ALICE_TOKEN=alice-token
export BOB_TOKEN=bob-token
